# Copy to keystore.properties (gitignored) and fill in to sign release builds
# locally. In CI, set the ANTIDOTO_* environment variables instead.
#
#   storeFile=/absolute/path/to/antidoto-release.keystore
#   storePassword=changeit
#   keyAlias=antidoto
#   keyPassword=changeit
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore antidoto-release.keystore \
#     -alias antidoto -keyalg RSA -keysize 2048 -validity 10000
#
# When neither keystore.properties nor the ANTIDOTO_* env vars are present,
# release builds fall back to debug signing so assembleRelease still succeeds.

storeFile=
storePassword=
keyAlias=
keyPassword=
